<?php

// PHẦN 1: Chèn vào <head> — kích hoạt dark mode SỚM, tránh flash trắng
function darkmode_head_script() {
    ?>
    <script src="https://cdn.jsdelivr.net/npm/darkreader@4.9.58/darkreader.min.js"></script>
    <script>
    (function() {
        if (localStorage.getItem('dm_mode') === 'dark') {
            DarkReader.enable({ brightness: 100, contrast: 90, sepia: 10 });
        }
    })();
    </script>
    <?php
}
add_action('wp_head', 'darkmode_head_script', 1); // priority 1 = chạy đầu tiên


// PHẦN 2: Chèn vào <footer> — xử lý nút toggle + style
function darkmode_footer_script() {
    ?>
    <script>
    function applyDarkMode(dark) {
        var sw    = document.getElementById('dm-switch');
        var label = document.getElementById('dm-label');
        if (dark) {
            DarkReader.enable({ brightness: 100, contrast: 90, sepia: 10 });
            if (sw)    sw.classList.add('on');
            if (label) label.textContent = 'Đang bật';
        } else {
            DarkReader.disable();
            if (sw)    sw.classList.remove('on');
            if (label) label.textContent = 'Đang tắt';
        }
        localStorage.setItem('dm_mode', dark ? 'dark' : 'light');
    }

    document.addEventListener('DOMContentLoaded', function() {
        var isDark = localStorage.getItem('dm_mode') === 'dark';
        if (isDark) {
            var sw    = document.getElementById('dm-switch');
            var label = document.getElementById('dm-label');
            if (sw)    sw.classList.add('on');
            if (label) label.textContent = 'Đang bật';
        }

        var wrap = document.getElementById('dm-toggle-wrap');
        if (wrap) {
            wrap.addEventListener('click', function() {
                var isDark = localStorage.getItem('dm_mode') === 'dark';
                applyDarkMode(!isDark);
            });
        }
    });
    </script>

    <style>
    #dm-toggle-wrap {
        display     : inline-flex;
        align-items : center;
        gap         : 10px;
        cursor      : pointer;
        font-size   : 14px;
        color       : inherit;
        user-select : none;
    }
    #dm-switch {
        width         : 44px;
        height        : 24px;
        border-radius : 999px;
        background    : #888;
        position      : relative;
        transition    : background .2s;
        flex-shrink   : 0;
    }
    #dm-switch.on        { background: #534AB7; }
    #dm-switch::after    { content: ''; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: #fff; transition: transform .2s; }
    #dm-switch.on::after { transform: translateX(20px); }
    </style>
    <?php
}
add_action('wp_footer', 'darkmode_footer_script');


// PHẦN 3: Shortcode (giữ nguyên)
function darkmode_shortcode() {
    return '
    <div id="dm-toggle-wrap" role="switch" aria-checked="false" aria-label="Bật/tắt chế độ tối" tabindex="0">
        <div id="dm-switch"></div>
        <span id="dm-label">Đang tắt</span>
        <span>🌙</span>
    </div>';
}
add_shortcode('darkmode_toggle', 'darkmode_shortcode');
